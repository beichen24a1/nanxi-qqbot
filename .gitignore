# ===== tools/ 里由脚本生成的中间产物 =====
# `tools\check_click_js.py` 每次运行都会把 browser.py 内联的那段 JS 抠到这里，
# 再交给 `node --check` 做语法检查 —— 它是产物、不是源码。
tools/_click_inline.js
